# Optional Wikimedia API key for wiki_* scripts.
# Loaded automatically from repo root .env via python-dotenv.
# Leave blank to use unauthenticated requests.
WIKIMEDIA_API_KEY=your_wikimedia_api_key_here

# Optional Enterprise auth credentials for `wiki_access.py login`
WIKIMEDIA_ENTERPRISE_USERNAME=your_enterprise_username
WIKIMEDIA_ENTERPRISE_PASSWORD=your_enterprise_password

# Stored/used by `wiki_access.py refresh`
WIKIMEDIA_ENTERPRISE_REFRESH_TOKEN=your_refresh_token_here
WIKIMEDIA_ENTERPRISE_ID_TOKEN=
WIKIMEDIA_ENTERPRISE_ACCESS_EXPIRES_IN=
WIKIMEDIA_ENTERPRISE_ACCESS_OBTAINED_AT=

# Optional API URL override. Keep this as the MediaWiki Action API endpoint
# unless you intentionally target a compatible proxy/service.
WIKIMEDIA_API_URL=https://en.wikipedia.org/w/api.php
